{
  "manifest_version": 3,
  "name": "Send to Pi (发送给 Pi)",
  "version": "1.0.2",
  "description": "Send webpage snippets, URLs, or articles directly to your local Pi coding agent terminal.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
